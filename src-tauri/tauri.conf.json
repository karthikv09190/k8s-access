{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "K8s Manager",
  "version": "1.0.0",
  "identifier": "com.karthikvellingiri.k8s-manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "K8s Manager",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": false
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Desktop Kubernetes UI",
    "longDescription": "A desktop application for managing Kubernetes clusters. View and manage pods, deployments, services, secrets and more across multiple clusters.",
    "copyright": "© 2025 Karthik Vellingiri",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
